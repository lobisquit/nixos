  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/A2F1-AF29";
      fsType = "vfat";
    };

  fileSystems."/mnt/storage_drive" =
    { device = "/dev/disk/by-uuid/4e609b0c-7266-4dd5-8271-49c0350f29dd";
      fsType = "ext4";
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/ecd68c65-90d7-4a26-8dee-4e25d3dba4f1"; }
